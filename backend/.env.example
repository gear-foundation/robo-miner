# Web3 Miner backend - modular monolith.
# Leave private keys empty for dry-run.

DIGGER_ADMIN_KEY=        # 0x... admin private key
CHAIN_NETWORK=mainnet
ETH_RPC=https://mainnet-reth-rpc.gear-tech.io
VARA_ETH_WS=wss://validator-1-eth.vara.network
ROUTER_ADDRESS=0x9C13FE9242dfe2ba2Cd446480A9308279aA74cb6

WORLD_PROGRAM_ID=
DIGGER_CODE_ID=0xb8f7a6b0f5b86d84b8a790857c9026287ad385f03c87f4e0840320cb74a81b03
DIGGER_PROXY_CODE_ID=0x2390d97aea22bbc45af6efe8bca29d06c80cebbddd55d9c0796eb724b77a5e93
DIGGER_PROXY_WASM_PATH=        # optional; default: ../contracts/target/wasm32-gear/release/digger_proxy.opt.wasm
DIGGER_TOP_UP=1200000000000000
DIGGER_PROGRAM_IDS=             # comma-separated existing digger/proxy program ids
DIGGER_DAILY_EXEC_TARGET=120000000000000
DIGGER_RENTAL_MODE=live
DIGGER_RENTAL_SEASON=season-1
SEASON_ID=season-1
BACKEND_STORE=postgres
DATABASE_URL=                  # postgres://user:pass@host:5432/dbname
DATABASE_SCHEMA=public
DATABASE_DOCUMENT_ID=mainnet
BACKEND_PORT=8787
DIGGER_BACKEND_URL=http://localhost:8787
ADMIN_API_TOKEN=                  # optional Bearer token for /api/admin/*
INDEXER_POLL_MS=3000
INDEXER_TIMEOUT_MS=180000
SCHEDULER_REGISTRY_MS=60000
SCHEDULER_SNAPSHOT_MS=30000
SCHEDULER_RENTAL_MS=3600000
BALANCE_CHECK_MS=30000
BALANCE_COOLDOWN_MS=120000
BALANCE_MIN_VARA=700
BALANCE_TOPUP_VARA=1200
INDEXER_WORLD_PROGRAM_IDS=
INDEXER_PROXY_PROGRAM_IDS=       # optional; otherwise DIGGER_PROGRAM_IDS are used
INDEXER_RES_VMT_PROGRAM_IDS=
INDEXER_REDEEM_PROGRAM_IDS=

SOCIAL_VERIFIER_MODE=mock       # mock | live
SOCIAL_X_BEARER_TOKEN=          # required when SOCIAL_VERIFIER_MODE=live
SOCIAL_X_SOURCE_USERNAME=VaraNetwork
SOCIAL_REPOST_FUEL_GRANT=60000000000000
SOCIAL_QUOTE_FUEL_GRANT=120000000000000

SESSION_MS=1800000                  # metadata/legacy duration; ignored when FACTORY_SESSION_AUTOFINISH=false
CONTRACT_SURFACE_Y=1

# World factory (registrar) - backend/src/modules/gameMaster/factory. Keeps a
# pool of live worlds and writes discovery/registry JSON for the frontend and agents.
FACTORY_LOBBY_MODE=true          # register in CREATED, start later when enough agents join
FACTORY_POOL_SIZE=6              # legacy default; FACTORY_POOL_MAX is preferred
FACTORY_POOL_MAX=6               # hard cap on total worlds (open+active); never use 0 on mainnet
FACTORY_MIN_OPEN=3               # BASE worlds kept running; grow on demand (only at 0 open lobbies) up to POOL_MAX
FACTORY_ALLOW_CREATE=true        # true: deploy+fund+init a new program on demand up to POOL_MAX; false: reuse a fixed preseeded pool only
FACTORY_LOBBY_MIN=1              # backend starts a lobby once this many agents register
FACTORY_LOBBY_CAP=10             # contract auto-starts at this many agents
FACTORY_LOBBY_TIMEOUT_MS=0       # legacy idle threshold; not needed with FACTORY_AUTOSTART_AT_MIN=true
FACTORY_AUTOSTART_AT_MIN=true
FACTORY_AUTOSTART_ON_TIMEOUT=false
FACTORY_SESSION_AUTOFINISH=false # active worlds run until admin/contract finish, not by SESSION_MS
FACTORY_TICK_MS=6000             # chain poll cadence
DIGGER_WASM_PATH=                # default: contracts/target/wasm32-gear/release/digger_world.opt.wasm
DIGGER_IDL_PATH=                 # default: backend/src/chain/diggerWorld.idl
DIGGER_EVENT_TIMEOUT_MS=180000
