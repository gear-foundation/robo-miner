CHAIN_NETWORK=mainnet
BACKEND_NETWORKS=mainnet,testnet
BACKEND_PORT=8787

DATABASE_URL=postgres://user:pass@localhost:5432/web3_miner
DATABASE_SCHEMA=public
BACKEND_STORE=postgres
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=20000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
DATABASE_UPDATE_MAX_ATTEMPTS=3
DATABASE_UPDATE_RETRY_BASE_MS=100

MAINNET_ADMIN_KEY=0xyour_mainnet_admin_private_key
TESTNET_ADMIN_KEY=0xyour_testnet_admin_private_key
ADMIN_API_TOKEN=change-me

DIGGER_BACKEND_URL=https://api-digger-eth.vara.network
SEASON_ID=season-1
DIGGER_RENTAL_MODE=dry-run
SOCIAL_VERIFIER_MODE=mock
SOCIAL_X_BEARER_TOKEN=

# Backend-mediated RES burn -> ERC-20 WVARA payout.
REDEEM_BACKEND_ENABLED=false
# Optional. When empty, the active network's MAINNET_ADMIN_KEY / TESTNET_ADMIN_KEY is used.
REDEEM_TREASURY_KEY=
DIGGER_RES_VMT_PROGRAM_ID=
DIGGER_REDEEM_PROGRAM_ID=
REDEEM_UNIT=1000000000000
REDEEM_SCRST_RATE=6
REDEEM_BCRST_RATE=30
REDEEM_HCRST_RATE=150
REDEEM_REQUEST_TTL_MS=600000
REDEEM_WORKER_INTERVAL_MS=5000
REDEEM_BURN_TIMEOUT_MS=180000
REDEEM_LEASE_MS=240000
REDEEM_MAX_ATTEMPTS=5
