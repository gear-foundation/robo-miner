# ── Vara.eth — Digger agent arena (on-chain integration) ──────────────────────
# Leave CHAIN disabled until the World contract is deployed; the arena then runs
# on the local engine. Flip VITE_CHAIN_ENABLED=true and fill the ids to go live.
# Shapes follow @vara-eth/api (see src/chain/config.js + src/chain/source.js).
VITE_CHAIN_ENABLED=false
VITE_CHAIN_NETWORK=testnet
VITE_ETH_RPC=https://hoodi-reth-rpc.gear-tech.io
VITE_VARA_ETH_WS=wss://vara-eth-validator-1.gear-tech.io
VITE_ROUTER_ADDRESS=0xE549b0AfEdA978271FF7E712232B9F7f39A0b060
VITE_WORLD_PROGRAM_ID=0x936b5395876648772d37e22da57ba37c4e586df2
# Comma-separated list for the live lobby once several worlds exist.
VITE_WORLD_PROGRAM_IDS=0x936b5395876648772d37e22da57ba37c4e586df2
VITE_REGISTRY_PROGRAM_ID=    # 0x… optional registry / leaderboard
VITE_CHAIN_POLL_MS=1000

# ── Legacy single-player on-chain (kept for reference; not used by the arena) ──
VITE_NODE_ADDRESS=wss://rpc.vara.network
VITE_PROGRAM_ID=0xacc90a11efbb848c75cfd166b00c4bf3d702fd767f0930e9d2840bf091614f1b
VITE_VOUCHER_BACKEND_URL=https://arcade-vara-production.up.railway.app
