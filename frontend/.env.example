# ── Vara.eth — Digger agent arena (on-chain integration) ──────────────────────
# Production chain mode. World discovery comes from VITE_BACKEND_URL; the world
# id list below is only an emergency fallback and should stay empty in deploys.
# Shapes follow @vara-eth/api (see src/chain/config.js + src/chain/source.js).
VITE_CHAIN_ENABLED=true
VITE_CHAIN_NETWORK=mainnet
VITE_ETH_RPC=https://mainnet-reth-rpc.gear-tech.io
VITE_VARA_ETH_WS=wss://validator-1-eth.vara.network
VITE_ROUTER_ADDRESS=0x9C13FE9242dfe2ba2Cd446480A9308279aA74cb6
VITE_WORLD_PROGRAM_ID=
# Optional comma-separated fallback only. Lobby normally reads /sessions.
VITE_WORLD_PROGRAM_IDS=
VITE_REGISTRY_PROGRAM_ID=    # 0x… optional registry / leaderboard
VITE_RES_VMT_PROGRAM_ID=
VITE_REDEEM_PROGRAM_ID=
VITE_BACKEND_URL=https://api-digger-eth.vara.network
# Optional override for factory discovery. Empty means "use VITE_BACKEND_URL".
VITE_MATCHES_URL=
