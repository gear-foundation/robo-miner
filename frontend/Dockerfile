FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_CHAIN_ENABLED
ARG VITE_CHAIN_NETWORK
ARG VITE_ETH_RPC
ARG VITE_VARA_ETH_WS
ARG VITE_ROUTER_ADDRESS
ARG VITE_WORLD_PROGRAM_ID
ARG VITE_WORLD_PROGRAM_IDS
ARG VITE_RES_VMT_PROGRAM_ID
ARG VITE_REDEEM_PROGRAM_ID
ARG VITE_BACKEND_URL
ARG VITE_MATCHES_URL
ARG VITE_CHAIN_POLL_MS
ARG VITE_CHAIN_RENDER_MODE
ARG VITE_CONTRACT_SURFACE_Y

ENV VITE_CHAIN_ENABLED=${VITE_CHAIN_ENABLED} \
    VITE_CHAIN_NETWORK=${VITE_CHAIN_NETWORK} \
    VITE_ETH_RPC=${VITE_ETH_RPC} \
    VITE_VARA_ETH_WS=${VITE_VARA_ETH_WS} \
    VITE_ROUTER_ADDRESS=${VITE_ROUTER_ADDRESS} \
    VITE_WORLD_PROGRAM_ID=${VITE_WORLD_PROGRAM_ID} \
    VITE_WORLD_PROGRAM_IDS=${VITE_WORLD_PROGRAM_IDS} \
    VITE_RES_VMT_PROGRAM_ID=${VITE_RES_VMT_PROGRAM_ID} \
    VITE_REDEEM_PROGRAM_ID=${VITE_REDEEM_PROGRAM_ID} \
    VITE_BACKEND_URL=${VITE_BACKEND_URL} \
    VITE_MATCHES_URL=${VITE_MATCHES_URL} \
    VITE_CHAIN_POLL_MS=${VITE_CHAIN_POLL_MS} \
    VITE_CHAIN_RENDER_MODE=${VITE_CHAIN_RENDER_MODE} \
    VITE_CONTRACT_SURFACE_Y=${VITE_CONTRACT_SURFACE_Y}

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npx vite build

FROM node:20-alpine AS run

WORKDIR /app

ENV NODE_ENV=production

RUN npm install -g serve@14

COPY --from=build --chown=node:node /app/dist ./dist

USER node

EXPOSE 5173

CMD ["serve", "-s", "dist", "-l", "5173"]
