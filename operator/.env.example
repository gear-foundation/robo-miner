# DiggerWorld operator - the admin account that uploads maps and drives sessions.
# Leave empty to run in dry-run (generate maps + UploadMap payloads, no chain).
DIGGER_ADMIN_KEY=        # 0x... admin private key (signs Admin.* calls)
ETH_RPC=https://hoodi-reth-rpc.gear-tech.io
VARA_ETH_WS=wss://vara-eth-validator-1.gear-tech.io
ROUTER_ADDRESS=0xE549b0AfEdA978271FF7E712232B9F7f39A0b060
WORLD_PROGRAM_ID=0x936b5395876648772d37e22da57ba37c4e586df2
SESSION_MS=1800000      # session length (ms) - 30 min
CONTRACT_SURFACE_Y=1    # raw contract surface row; Config()[6] is starting_hp

# World factory (registrar) — src/factory. Lobby rules now partly on-chain:
# the contract auto-starts at 10 participants and requires >=8 for a manual start.
FACTORY_LOBBY_MODE=true          # true once the lobby contract is deployed (register in CREATED)
FACTORY_POOL_SIZE=3              # max concurrent worlds (programs) in the pool
FACTORY_MIN_OPEN=1              # always keep >= this many open lobbies
FACTORY_LOBBY_MIN=8            # MIN_SESSION_PARTICIPANTS (manual/idle start needs this)
FACTORY_LOBBY_CAP=10          # AUTO_START_SESSION_PARTICIPANTS (contract auto-starts here)
FACTORY_LOBBY_TIMEOUT_MS=300000  # 5 min idle-since-last-join → start (if >=8)
FACTORY_AUTOSTART_ON_TIMEOUT=false  # false → flag for manual start instead of auto
FACTORY_TICK_MS=6000            # chain poll cadence
DIGGER_CODE_ID=                 # set to skip re-validation once the code is validated
DIGGER_WASM_PATH=               # default: ../contracts/target/wasm32-gear/release/digger_world.opt.wasm
DIGGER_IDL_PATH=                # default: src/chain/world.idl
DIGGER_EVENT_TIMEOUT_MS=180000

# GameMaster registry / scheduling.
GAMEMASTER_STATE_DIR=state
GAMEMASTER_WORLD_INTERVAL_MS=1800000
GAMEMASTER_MIN_AGENTS=10
GAMEMASTER_TARGET_AGENTS=10
GAMEMASTER_DEPLOY_MODE=dry-run
DIGGER_TOP_UP=100000000000000
