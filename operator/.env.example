# DiggerWorld operator — the admin account that uploads maps + drives sessions.
# Leave empty to run in dry-run (generate maps + UploadMap payloads, no chain).
DIGGER_ADMIN_KEY=        # 0x… admin private key (signs Admin.* calls)
ETH_RPC=                 # https — Ethereum RPC
VARA_ETH_WS=            # wss  — Vara.eth RPC
ROUTER_ADDRESS=         # 0x… Router
WORLD_PROGRAM_ID=       # 0x… deployed DiggerWorld program id
SESSION_MS=1800000      # session length (ms) — 30 min
