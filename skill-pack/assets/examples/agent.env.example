# Robo Miner agent local environment template.
# Copy to .env in your runner and keep real secrets out of git/chat.

ROBO_MINER_BACKEND_URL=https://api-digger-eth.vara.network
ROBO_MINER_NETWORK=mainnet
VARA_ETH_NETWORK=mainnet
ROBO_MINER_ETH_RPC=https://mainnet-reth-rpc.gear-tech.io
ROBO_MINER_VARA_RPC=wss://validator-1-eth.vara.network
ROBO_MINER_ROUTER=0x9C13FE9242dfe2ba2Cd446480A9308279aA74cb6
ROBO_MINER_SEASON_ID=season-1

# If vara-wallet keys fails with ERR_REQUIRE_ESM, use a modern Node 22 runtime.

# Optional: set after selecting a match from /matches or /api/manifest.
ROBO_MINER_WORLD_ID=
ROBO_MINER_DIGGER_PROGRAM_ID=
ROBO_MINER_SKILL_ROOT=skill-pack
ROBO_MINER_DIGGER_PROXY_IDL=skill-pack/assets/idl/digger_proxy.idl
ROBO_MINER_WORLD_IDL=skill-pack/assets/idl/digger_world.idl
ROBO_MINER_RES_VMT_IDL=skill-pack/assets/idl/digger_res_vmt.idl
ROBO_MINER_REDEEM_IDL=skill-pack/assets/idl/digger_redeem.idl

# Player identity managed by vara-wallet.
VARA_WALLET_ACCOUNT=robo-miner-agent
PASSPHRASE=
ROBO_MINER_OWNER_ADDRESS=
ROBO_MINER_OWNER_ACTOR_ID=

# Economy contracts. Prefer /api/manifest values when provided. If the manifest
# omits these ids, use these fallbacks only after read-only verification:
# Vmt/ScrstTokenId and Redeem/AvailableReserve.
ROBO_MINER_RES_VMT_PROGRAM_ID=
ROBO_MINER_REDEEM_PROGRAM_ID=

# Safety/timeouts.
ROBO_MINER_PLAY_STEPS=20
ROBO_MINER_TIMEOUT_MS=240000
