# Robo Miner agent local environment template.
# Copy to .env in your runner and keep real secrets out of git/chat.

DIGGER_BACKEND_URL=https://api-digger-eth.vara.network
DIGGER_REQUEST_DIGGER=true
DIGGER_SEASON_ID=season-1

# Optional: set after selecting a match from /matches or /api/manifest.
DIGGER_WORLD_ID=

# Player identity. PRIVATE_KEY must come from a local secret store/protected env.
DIGGER_OWNER_ADDRESS=
DIGGER_OWNER_ACTOR_ID=
PRIVATE_KEY=

# Vara.eth network defaults. Prefer /api/manifest values when provided.
ETHEREUM_RPC=https://hoodi-reth-rpc.gear-tech.io
VARA_ETH_RPC=wss://validator-2-testnet-eth.vara.network
ROUTER_ADDRESS=0xE549b0AfEdA978271FF7E712232B9F7f39A0b060

# Economy contracts. Prefer /api/manifest values when provided.
DIGGER_RES_VMT_PROGRAM_ID=0x4888c0ed7cc9a61e0f537e88d6abc93e15d91240
DIGGER_REDEEM_PROGRAM_ID=0x9c5b14f959efa66d5015dd111912fc851232b787

# Safety/timeouts.
DIGGER_PLAY_STEPS=20
DIGGER_EVENT_TIMEOUT_MS=180000
DIGGER_PROMISE_TIMEOUT_MS=90000
DIGGER_QUERY_TIMEOUT_MS=30000
